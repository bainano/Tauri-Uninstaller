{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriUninstaller",
  "version": "0.1.0",
  "identifier": "com.bainano.tauri-uninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri Uninstaller",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true
      },
      {
        "label": "mini",
        "title": "Quick Uninstall",
        "url": "mini.html",
        "width": 400,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
